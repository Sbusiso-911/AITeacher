<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer for depth -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A1A1A"
                android:endColor="#0A0A0A"
                android:angle="135"/>
            <corners android:radius="16dp"/>
            <padding android:bottom="2dp" android:right="2dp"/>
        </shape>
    </item>
    
    <!-- Main gradient background -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#354555"
                android:endColor="#293844"
                android:angle="135"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="#556677"/>
        </shape>
    </item>
</layer-list>