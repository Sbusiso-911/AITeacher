<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#2A3B4A"
                android:endColor="#1F2D3A"
                android:angle="135"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Circuit board pattern -->
    <!-- Horizontal circuit lines -->
    <item android:top="12dp" android:left="8dp" android:right="40dp">
        <shape android:shape="rectangle">
            <solid android:color="#25FFFFFF"/>
            <size android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="32dp" android:left="20dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF"/>
            <size android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="20dp" android:left="12dp" android:right="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#18FFFFFF"/>
            <size android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Vertical circuit lines -->
    <item android:top="8dp" android:bottom="60dp" android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#25FFFFFF"/>
            <size android:width="1dp"/>
        </shape>
    </item>
    
    <item android:top="24dp" android:bottom="8dp" android:right="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF"/>
            <size android:width="1dp"/>
        </shape>
    </item>
    
    <!-- Circuit nodes/junctions -->
    <item android:top="11dp" android:left="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#35FFFFFF"/>
            <size android:width="3dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="31dp" android:right="19dp">
        <shape android:shape="rectangle">
            <solid android:color="#30FFFFFF"/>
            <size android:width="3dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:bottom="19dp" android:left="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#28FFFFFF"/>
            <size android:width="3dp" android:height="3dp"/>
        </shape>
    </item>
    
    <!-- Microchip representations -->
    <item android:top="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF"/>
            <corners android:radius="1dp"/>
            <size android:width="6dp" android:height="4dp"/>
        </shape>
    </item>
    
    <item android:bottom="8dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#18FFFFFF"/>
            <corners android:radius="1dp"/>
            <size android:width="4dp" android:height="6dp"/>
        </shape>
    </item>
</layer-list>