<!-- res/drawable/gradient_black.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0A0A0A"/>
            <corners android:radius="12dp"/>
            <padding android:bottom="2dp" android:right="2dp"/>
        </shape>
    </item>

    <!-- Main gradient with dark theme -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A2B3A"
                android:endColor="#0F1A25"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#334455"/>
        </shape>
    </item>
</layer-list>