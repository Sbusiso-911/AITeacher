<!-- res/drawable/gradient_magenta.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A"/>
            <corners android:radius="12dp"/>
            <padding android:bottom="2dp" android:right="2dp"/>
        </shape>
    </item>

    <!-- Main gradient -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#354555"
                android:endColor="#293844"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#556677"/>
        </shape>
    </item>
</layer-list>