<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="400dp"
    android:height="600dp"
    android:viewportWidth="400"
    android:viewportHeight="600">
    
    <!-- Background -->
    <path android:pathData="M0,0 L400,0 L400,600 L0,600 Z"
          android:fillColor="@color/cyber_background"/>
    
    <!-- Circuit board pattern -->
    <group android:name="circuit_pattern">
        <!-- Horizontal lines -->
        <path android:pathData="M50,100 L350,100 M50,200 L350,200 M50,400 L350,400 M50,500 L350,500"
              android:strokeColor="@color/cyber_primary_30"
              android:strokeWidth="1"/>
        <!-- Vertical lines -->
        <path android:pathData="M100,50 L100,550 M200,50 L200,550 M300,50 L300,550"
              android:strokeColor="@color/cyber_primary_30"
              android:strokeWidth="1"/>
        
        <!-- Circuit nodes -->
        <path android:pathData="M97,100 A3,3 0 1,1 103,100 A3,3 0 1,1 97,100"
              android:fillColor="@color/cyber_primary"/>
        <path android:pathData="M197,100 A3,3 0 1,1 203,100 A3,3 0 1,1 197,100"
              android:fillColor="@color/cyber_primary"/>
        <path android:pathData="M297,100 A3,3 0 1,1 303,100 A3,3 0 1,1 297,100"
              android:fillColor="@color/cyber_primary"/>
        <path android:pathData="M97,200 A3,3 0 1,1 103,200 A3,3 0 1,1 97,200"
              android:fillColor="@color/cyber_glow"/>
        <path android:pathData="M197,200 A3,3 0 1,1 203,200 A3,3 0 1,1 197,200"
              android:fillColor="@color/cyber_glow"/>
        <path android:pathData="M297,200 A3,3 0 1,1 303,200 A3,3 0 1,1 297,200"
              android:fillColor="@color/cyber_glow"/>
    </group>
    
    <!-- Robot head -->
    <group android:name="robot_head">
        <!-- Head outline -->
        <path android:pathData="M160,180 Q200,160 240,180 L240,240 Q200,260 160,240 Z"
              android:fillColor="@color/cyber_secondary"
              android:strokeColor="@color/cyber_primary"
              android:strokeWidth="2"/>
        
        <!-- Neural network display -->
        <group android:name="neural_display">
            <path android:pathData="M180,200 L220,200 M200,185 L200,215 M190,190 L210,210 M210,190 L190,210"
                  android:strokeColor="@color/cyber_primary"
                  android:strokeWidth="1"/>
            <!-- Neural nodes -->
            <path android:pathData="M178,200 A2,2 0 1,1 182,200 A2,2 0 1,1 178,200"
                    android:fillColor="@color/cyber_electric"/>
            <path android:pathData="M198,185 A2,2 0 1,1 202,185 A2,2 0 1,1 198,185"
                    android:fillColor="@color/cyber_electric"/>
            <path android:pathData="M218,200 A2,2 0 1,1 222,200 A2,2 0 1,1 218,200"
                    android:fillColor="@color/cyber_electric"/>
            <path android:pathData="M198,215 A2,2 0 1,1 202,215 A2,2 0 1,1 198,215"
                    android:fillColor="@color/cyber_electric"/>
        </group>
        
        <!-- Eyes -->
        <path android:pathData="M178,210 Q175,210 175,213 Q175,216 178,216 L184,216 Q187,216 187,213 Q187,210 184,210 Z"
              android:fillColor="@color/cyber_primary"/>
        <path android:pathData="M216,210 Q213,210 213,213 Q213,216 216,216 L222,216 Q225,216 225,213 Q225,210 222,210 Z"
              android:fillColor="@color/cyber_primary"/>
        
        <!-- Antenna -->
        <path android:pathData="M200,180 L200,160 L195,155 M200,160 L205,155"
              android:strokeColor="@color/cyber_primary"
              android:strokeWidth="2"/>
        <!-- Antenna tip -->
        <path android:pathData="M197,155 A3,3 0 1,1 203,155 A3,3 0 1,1 197,155"
                android:fillColor="@color/cyber_status_green"/>
    </group>
    
    <!-- Robot body -->
    <group android:name="robot_body">
        <!-- Main body -->
        <path android:pathData="M180,260 Q170,260 170,270 L170,330 Q170,340 180,340 L220,340 Q230,340 230,330 L230,270 Q230,260 220,260 Z"
              android:fillColor="@color/cyber_secondary"
              android:strokeColor="@color/cyber_primary"
              android:strokeWidth="2"/>
        
        <!-- Control panel -->
        <path android:pathData="M185,280 Q180,280 180,285 L180,315 Q180,320 185,320 L215,320 Q220,320 220,315 L220,285 Q220,280 215,280 Z"
              android:fillColor="@color/cyber_background"
              android:strokeColor="@color/cyber_primary"
              android:strokeWidth="1"/>
        
        <!-- Status lights -->
        <path android:pathData="M187,290 A3,3 0 1,1 193,290 A3,3 0 1,1 187,290"
                android:fillColor="@color/cyber_status_green"/>
        <path android:pathData="M197,290 A3,3 0 1,1 203,290 A3,3 0 1,1 197,290"
                android:fillColor="@color/cyber_primary"/>
        <path android:pathData="M207,290 A3,3 0 1,1 213,290 A3,3 0 1,1 207,290"
                android:fillColor="@color/cyber_warning"/>
        
        <!-- Data display -->
        <path android:pathData="M185,305 L215,305 L215,315 L185,315 Z"
              android:fillColor="@color/cyber_background"/>
        <path android:pathData="M187,307 L195,307 M187,310 L205,310 M187,313 L190,313"
              android:strokeColor="@color/cyber_primary"
              android:strokeWidth="0.5"/>
    </group>
    
    <!-- Arms -->
    <group android:name="robot_arms">
        <!-- Left arm -->
        <path android:pathData="M144,280 Q140,280 140,284 Q140,288 144,288 L166,288 Q170,288 170,284 Q170,280 166,280 Z"
              android:fillColor="@color/cyber_secondary"
              android:strokeColor="@color/cyber_primary"
              android:strokeWidth="1"/>
        <!-- Right arm -->
        <path android:pathData="M234,280 Q230,280 230,284 Q230,288 234,288 L256,288 Q260,288 260,284 Q260,280 256,280 Z"
              android:fillColor="@color/cyber_secondary"
              android:strokeColor="@color/cyber_primary"
              android:strokeWidth="1"/>
    </group>
    
    <!-- Data streams -->
    <group android:name="data_streams">
        <path android:pathData="M100,350 Q150,370 200,360 Q250,350 300,370"
              android:strokeColor="@color/cyber_primary_50"
              android:strokeWidth="2"
              android:fillType="nonZero"/>
        <path android:pathData="M80,450 Q200,430 320,450"
              android:strokeColor="@color/cyber_glow"
              android:strokeWidth="1"/>
    </group>
    
    <!-- Binary code decoration -->
    <group android:name="binary_code">
        <!-- Binary "1010" as decorative rectangles -->
        <path android:pathData="M50,370 L52,370 L52,380 L50,380 Z M54,370 L58,370 L58,380 L54,380 Z M60,370 L62,370 L62,380 L60,380 Z M64,370 L68,370 L68,380 L64,380 Z"
              android:fillColor="@color/cyber_primary_30"/>
        <!-- Binary "0101" as decorative rectangles -->
        <path android:pathData="M320,410 L324,410 L324,420 L320,420 Z M326,410 L328,410 L328,420 L326,420 Z M330,410 L334,410 L334,420 L330,420 Z M336,410 L338,410 L338,420 L336,420 Z"
              android:fillColor="@color/cyber_primary_30"/>
        <!-- Binary "1100" as decorative rectangles -->
        <path android:pathData="M150,470 L152,470 L152,480 L150,480 Z M154,470 L156,470 L156,480 L154,480 Z M158,470 L162,470 L162,480 L158,480 Z M164,470 L168,470 L168,480 L164,480 Z"
              android:fillColor="@color/cyber_primary_30"/>
    </group>
</vector>