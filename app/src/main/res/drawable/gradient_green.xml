<!-- res/drawable/gradient_green.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A"/>
            <corners android:radius="12dp"/>
            <padding android:bottom="2dp" android:right="2dp"/>
        </shape>
    </item>

    <!-- Main gradient -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A2B3A"
                android:endColor="#0F1A25"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#334455"/>
        </shape>
    </item>
    
    <!-- Pi Symbol π (Top Left) -->
    <item android:top="8dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="8dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:left="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="6dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:left="13dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="6dp"/>
        </shape>
    </item>
    
    <!-- Square root √ (Bottom Right) -->
    <item android:bottom="8dp" android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:bottom="8dp" android:right="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="2dp"/>
        </shape>
    </item>
    
    <item android:bottom="10dp" android:right="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="6dp"/>
        </shape>
    </item>
    
    <item android:bottom="15dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="6dp" android:height="1dp"/>
        </shape>
    </item>
</layer-list>