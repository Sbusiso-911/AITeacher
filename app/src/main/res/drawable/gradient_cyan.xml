<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A"/>
            <corners android:radius="12dp"/>
            <padding android:bottom="2dp" android:right="2dp"/>
        </shape>
    </item>
    
    <!-- Main gradient -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#354555"
                android:endColor="#293844"
                android:angle="135"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#556677"/>
        </shape>
    </item>
    
    <!-- Code Brackets < > (Top Left) -->
    <item android:top="8dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="12dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Binary code 101 (Middle) -->
    <item android:top="18dp" android:left="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="18dp" android:left="16dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="2dp"/>
        </shape>
    </item>
    
    <item android:top="18dp" android:left="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <!-- Function f(x) (Bottom Right) -->
    <item android:bottom="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="6dp"/>
        </shape>
    </item>
    
    <item android:bottom="12dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="3dp" android:height="1dp"/>
        </shape>
    </item>
</layer-list>