<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <!-- Premium gradient for pressed state -->
            <gradient
                android:startColor="@color/btn_premium_pressed"
                android:endColor="@color/btn_premium_hover"
                android:angle="135"/>
            <corners android:radius="16dp"/>
            <stroke 
                android:width="2dp" 
                android:color="@color/theme_primary"/>
        </shape>
    </item>
    
    <!-- Disabled State -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_text_disabled"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Normal State -->
    <item>
        <shape android:shape="rectangle">
            <!-- Premium gradient -->
            <gradient
                android:startColor="@color/btn_premium_bg"
                android:endColor="@color/btn_premium_hover"
                android:angle="135"/>
            <corners android:radius="16dp"/>
            <stroke 
                android:width="1dp" 
                android:color="@color/theme_primary"/>
        </shape>
    </item>
    
</selector>