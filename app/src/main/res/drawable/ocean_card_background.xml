<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/ocean_surface_light"
                android:endColor="@color/ocean_surface"/>
            <corners android:radius="16dp"/>
            <stroke 
                android:width="1dp" 
                android:color="@color/ocean_primary"/>
        </shape>
    </item>
    
    <!-- Normal State -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/ocean_surface_transparent"
                android:endColor="@color/ocean_surface"/>
            <corners android:radius="16dp"/>
            <stroke 
                android:width="1dp" 
                android:color="@color/ocean_border_primary"/>
        </shape>
    </item>
    
</selector>