<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#354555"
                android:endColor="#293844"
                android:angle="135"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Code Brackets < > (Top Left) -->
    <item android:top="8dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="12dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Closing bracket -->
    <item android:top="8dp" android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:left="17dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="12dp" android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Binary code 01101 (Middle) -->
    <item android:top="20dp" android:left="12dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="2dp"/>
        </shape>
    </item>
    
    <item android:top="20dp" android:left="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="20dp" android:left="20dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="20dp" android:left="24dp">
        <shape android:shape="oval">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="2dp"/>
        </shape>
    </item>
    
    <item android:top="20dp" android:left="28dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <!-- Function symbol f(x) (Bottom Right) -->
    <item android:bottom="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="8dp"/>
        </shape>
    </item>
    
    <item android:bottom="14dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="3dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="11dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="2dp" android:height="1dp"/>
        </shape>
    </item>
    
    <!-- (x) part -->
    <item android:bottom="8dp" android:right="12dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#FFFFFF"/>
            <size android:width="6dp" android:height="6dp"/>
        </shape>
    </item>
    
    <!-- X inside circle -->
    <item android:bottom="10dp" android:right="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="11dp" android:right="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="12dp" android:right="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="11dp" android:right="16dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="10dp" android:right="14dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="1dp"/>
        </shape>
    </item>
</layer-list>