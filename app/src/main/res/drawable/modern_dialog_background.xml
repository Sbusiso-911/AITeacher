<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    
    <!-- Theme-based dialog background -->
    <gradient
        android:startColor="@color/theme_surface"
        android:endColor="@color/theme_surface_variant"
        android:angle="135"/>
    
    <corners android:radius="20dp"/>
    
    <!-- Theme glass border -->
    <stroke 
        android:width="1dp" 
        android:color="@color/glass_border"/>
        
</shape>