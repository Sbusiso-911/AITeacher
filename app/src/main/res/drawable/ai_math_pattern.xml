<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A2B3A"
                android:endColor="#0F1A25"
                android:angle="135"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Pi Symbol π (Top Left) -->
    <item android:top="8dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="8dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:left="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="6dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:left="13dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="6dp"/>
        </shape>
    </item>
    
    <!-- Sigma Σ (Top Right) -->
    <item android:top="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="6dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="9dp" android:right="13dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="11dp" android:right="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="3dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:top="12dp" android:right="13dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="14dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="6dp" android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Infinity ∞ (Middle) -->
    <item android:top="22dp" android:left="16dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#FFFFFF"/>
            <size android:width="4dp" android:height="4dp"/>
        </shape>
    </item>
    
    <item android:top="22dp" android:left="20dp">
        <shape android:shape="oval">
            <solid android:color="#00000000"/>
            <stroke android:width="1dp" android:color="#FFFFFF"/>
            <size android:width="4dp" android:height="4dp"/>
        </shape>
    </item>
    
    <!-- Square root √ (Bottom Left) -->
    <item android:bottom="8dp" android:left="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:bottom="8dp" android:left="9dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="2dp"/>
        </shape>
    </item>
    
    <item android:bottom="10dp" android:left="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="6dp"/>
        </shape>
    </item>
    
    <item android:bottom="15dp" android:left="11dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="6dp" android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Plus/Minus ± (Bottom Right) -->
    <item android:bottom="12dp" android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="5dp"/>
        </shape>
    </item>
    
    <item android:bottom="14dp" android:right="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="7dp" android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="8dp" android:right="15dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="7dp" android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Angle symbol ∠ -->
    <item android:bottom="20dp" android:left="24dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="1dp" android:height="4dp"/>
        </shape>
    </item>
    
    <item android:bottom="20dp" android:left="25dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF"/>
            <size android:width="4dp" android:height="1dp"/>
        </shape>
    </item>
</layer-list>