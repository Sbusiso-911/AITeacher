<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A2B3A"
                android:endColor="#0F1A25"
                android:angle="135"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    
    <!-- Neural network dots pattern -->
    <item android:top="8dp" android:left="12dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF"/>
            <size android:width="3dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:top="24dp" android:left="28dp">
        <shape android:shape="oval">
            <solid android:color="#30FFFFFF"/>
            <size android:width="2dp" android:height="2dp"/>
        </shape>
    </item>
    
    <item android:top="16dp" android:right="20dp">
        <shape android:shape="oval">
            <solid android:color="#35FFFFFF"/>
            <size android:width="2.5dp" android:height="2.5dp"/>
        </shape>
    </item>
    
    <item android:bottom="12dp" android:left="18dp">
        <shape android:shape="oval">
            <solid android:color="#40FFFFFF"/>
            <size android:width="3dp" android:height="3dp"/>
        </shape>
    </item>
    
    <item android:bottom="28dp" android:right="16dp">
        <shape android:shape="oval">
            <solid android:color="#30FFFFFF"/>
            <size android:width="2dp" android:height="2dp"/>
        </shape>
    </item>
    
    <!-- Connecting lines (simplified neural network) -->
    <item android:top="20dp" android:left="8dp" android:right="8dp">
        <shape android:shape="rectangle">
            <solid android:color="#20FFFFFF"/>
            <size android:height="1dp"/>
        </shape>
    </item>
    
    <item android:bottom="20dp" android:left="12dp" android:right="12dp">
        <shape android:shape="rectangle">
            <solid android:color="#15FFFFFF"/>
            <size android:height="1dp"/>
        </shape>
    </item>
    
    <!-- Subtle AI circuit pattern overlay -->
    <item android:top="6dp" android:right="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#10FFFFFF"/>
            <size android:width="8dp" android:height="2dp"/>
        </shape>
    </item>
    
    <item android:bottom="6dp" android:left="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#10FFFFFF"/>
            <size android:width="6dp" android:height="2dp"/>
        </shape>
    </item>
</layer-list>