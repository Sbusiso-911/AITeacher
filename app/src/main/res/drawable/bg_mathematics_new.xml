<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Base dark gradient background -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#1A2B3A"
                android:centerColor="#2A3B4A"
                android:endColor="#1A2B3A"
                android:angle="135"/>
        </shape>
    </item>
    
    <!-- Pi Symbol (π) - Simplified and Larger -->
    <item android:top="80dp" android:left="50dp">
        <shape android:shape="rectangle">
            <solid android:color="#80FFD700"/>
            <size android:width="30dp" android:height="4dp"/>
        </shape>
    </item>
    <item android:top="84dp" android:left="58dp">
        <shape android:shape="rectangle">
            <solid android:color="#80FFD700"/>
            <size android:width="4dp" android:height="20dp"/>
        </shape>
    </item>
    <item android:top="84dp" android:left="68dp">
        <shape android:shape="rectangle">
            <solid android:color="#80FFD700"/>
            <size android:width="4dp" android:height="20dp"/>
        </shape>
    </item>
    
    <!-- Infinity Symbol (∞) - Using ovals -->
    <item android:top="150dp" android:left="200dp">
        <shape android:shape="oval">
            <solid android:color="#80E6F3FF"/>
            <size android:width="20dp" android:height="10dp"/>
        </shape>
    </item>
    <item android:top="150dp" android:left="225dp">
        <shape android:shape="oval">
            <solid android:color="#80E6F3FF"/>
            <size android:width="20dp" android:height="10dp"/>
        </shape>
    </item>
    
    <!-- Square Root Symbol (√) -->
    <item android:top="220dp" android:left="80dp">
        <shape android:shape="rectangle">
            <solid android:color="#80A0C0FF"/>
            <size android:width="3dp" android:height="15dp"/>
        </shape>
    </item>
    <item android:top="230dp" android:left="83dp">
        <shape android:shape="rectangle">
            <solid android:color="#80A0C0FF"/>
            <size android:width="8dp" android:height="3dp"/>
        </shape>
    </item>
    <item android:top="220dp" android:left="91dp">
        <shape android:shape="rectangle">
            <solid android:color="#80A0C0FF"/>
            <size android:width="3dp" android:height="15dp"/>
        </shape>
    </item>
    <item android:top="220dp" android:left="94dp">
        <shape android:shape="rectangle">
            <solid android:color="#80A0C0FF"/>
            <size android:width="20dp" android:height="3dp"/>
        </shape>
    </item>
    
    <!-- Plus Symbol (+) -->
    <item android:top="320dp" android:left="150dp">
        <shape android:shape="rectangle">
            <solid android:color="#80FFD700"/>
            <size android:width="20dp" android:height="4dp"/>
        </shape>
    </item>
    <item android:top="312dp" android:left="158dp">
        <shape android:shape="rectangle">
            <solid android:color="#80FFD700"/>
            <size android:width="4dp" android:height="20dp"/>
        </shape>
    </item>
    
    <!-- Equals Symbol (=) -->
    <item android:top="400dp" android:left="250dp">
        <shape android:shape="rectangle">
            <solid android:color="#80E6F3FF"/>
            <size android:width="25dp" android:height="4dp"/>
        </shape>
    </item>
    <item android:top="410dp" android:left="250dp">
        <shape android:shape="rectangle">
            <solid android:color="#80E6F3FF"/>
            <size android:width="25dp" android:height="4dp"/>
        </shape>
    </item>
    
    <!-- Simple Triangle -->
    <item android:top="500dp" android:left="100dp">
        <shape android:shape="rectangle">
            <solid android:color="#80A0C0FF"/>
            <size android:width="30dp" android:height="4dp"/>
        </shape>
    </item>
    <item android:top="485dp" android:left="114dp">
        <shape android:shape="rectangle">
            <solid android:color="#80A0C0FF"/>
            <size android:width="4dp" android:height="20dp"/>
        </shape>
    </item>
    
</layer-list>