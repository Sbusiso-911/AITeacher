<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Focused State -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_surface_transparent"/>
            <corners android:radius="12dp"/>
            <stroke 
                android:width="1dp" 
                android:color="@color/ocean_primary"/>
        </shape>
    </item>
    
    <!-- Normal State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_surface_transparent"/>
            <corners android:radius="12dp"/>
            <stroke 
                android:width="1dp" 
                android:color="@color/ocean_border_light"/>
        </shape>
    </item>
    
</selector>