<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_dark_secondary_container"/>
            <corners android:radius="@dimen/chip_corner_radius"/>
            <stroke 
                android:width="1dp" 
                android:color="@color/md_theme_dark_secondary"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/md_theme_dark_surface_variant"/>
            <corners android:radius="@dimen/chip_corner_radius"/>
            <stroke 
                android:width="1dp" 
                android:color="@color/md_theme_dark_outline"/>
        </shape>
    </item>
</selector>