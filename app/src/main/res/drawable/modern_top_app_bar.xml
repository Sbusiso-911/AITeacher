<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Base gradient background following theme -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/theme_primary"
                android:endColor="@color/theme_primary_dark"
                android:angle="270"/>
        </shape>
    </item>
    
    <!-- Subtle glassmorphism overlay -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_overlay_light"/>
        </shape>
    </item>
    
    <!-- Bottom border using secondary color -->
    <item android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/theme_secondary"/>
            <size android:height="2dp"/>
        </shape>
    </item>
    
</layer-list>