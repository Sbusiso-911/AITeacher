<!-- res/drawable/gradient_red.xml -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow Layer -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#1A1A1A"/>
            <corners android:radius="12dp"/>
            <padding android:bottom="2dp" android:right="2dp"/>
        </shape>
    </item>
    
    <!-- Main gradient with glass effect -->
    <item android:top="1dp" android:left="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#B32A3B4A"/>
            <corners android:radius="12dp"/>
            <stroke
                android:width="1dp"
                android:color="#556677"/>
        </shape>
    </item>
    
    <!-- Top highlight for glass effect -->
    <item android:top="1dp" android:left="1dp" android:right="1dp" android:bottom="30dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#40FFFFFF"
                android:endColor="#10FFFFFF"
                android:angle="270"/>
            <corners android:topLeftRadius="12dp" android:topRightRadius="12dp"/>
        </shape>
    </item>
</layer-list>