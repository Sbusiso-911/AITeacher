<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- Declare any variables here -->
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:fitsSystemWindows="true"
        tools:context=".MainActivity">

        <!-- Fixed AI Theme Background -->
        <ImageView
            android:id="@+id/ai_theme_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:alpha="1.0"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ScrollView to make the content scrollable -->
        <ScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/adContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Non-chat elements -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/non_chat_elements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp"
                android:background="@android:color/transparent"
                android:fitsSystemWindows="true"
                tools:context=".MainActivity">

                <!-- Badge Container -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/badge_container"
                    android:layout_width="0dp"
                    android:layout_height="96dp"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Outer Badge Background -->
                    <View
                        android:id="@+id/badgeBackground"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/subscription_option_popular"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- Badge ImageView (now on the right) -->
                    <ImageView
                        android:id="@+id/badgeImageView"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:src="@drawable/bronze_badge"
                        android:contentDescription="@string/badge_image_desc"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <!-- "Pro" Text (middle-left) -->
                    <TextView
                        android:id="@+id/badgeTextView"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:text="Pro"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/pro_background"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        android:layout_marginStart="16dp"/>
                    <!-- "Premium Active" Text (middle top, bold) -->
                    <TextView
                        android:id="@+id/subscriptionStatusText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="Premium Active"
                        android:textColor="@color/green"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/badgeImageView"
                        android:layout_marginTop="16dp"/>

                    <!-- Timer Text (middle bottom) -->
                    <TextView
                        android:id="@+id/subscriptionTimer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="12 days remaining"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"
                        android:gravity="center"
                        app:layout_constraintTop_toBottomOf="@id/subscriptionStatusText"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/badgeImageView"
                        android:layout_marginBottom="16dp"/>
                </androidx.constraintlayout.widget.ConstraintLayout>





                <com.playstudio.aiteacher.GradientButton
                    android:id="@+id/buyButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="✨ UNLOCK PREMIUM ✨\nRemove Ads • GET All AI Models - More accurate responses + Image generator • unlimited chat"
                    android:textColor="@android:color/white"
                    android:textSize="18sp"
                    android:letterSpacing="0.03"
                    android:lineSpacingExtra="2sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    android:elevation="8dp"
                    android:stateListAnimator="@null"
                    android:outlineProvider="background"
                    app:layout_constraintTop_toBottomOf="@id/badge_container"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.9"
                    app:buttonCornerRadius="32dp"
                    android:textAllCaps="false"
                    android:shadowColor="#80000000"
                    android:shadowDx="1"
                    android:shadowDy="1"
                    android:shadowRadius="2"
                    app:startColor="@color/premium_gradient_start"
                    app:endColor="@color/premium_gradient_end"
                    app:strokeWidth="2dp"
                    app:strokeColor="@android:color/white"/>
                <!-- HorizontalScrollView for recent conversation icons -->
                <HorizontalScrollView
                    android:id="@+id/recentConversationsLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    app:layout_constraintTop_toBottomOf="@+id/buyButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="8dp"
                    android:contentDescription="@string/recent_conversations_desc">



                    <LinearLayout
                        android:id="@+id/recentConversationsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">
                        <!-- Dynamic buttons will be added here -->
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Subjects Section -->
                <LinearLayout
                    android:id="@+id/subjectsTitleContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@id/recentConversationsLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Elite Tools"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:layout_marginBottom="16dp"/>

                    <HorizontalScrollView
                        android:id="@+id/subjectsScrollView"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:paddingVertical="8dp"
                        android:importantForAccessibility="yes"
                        android:contentDescription="@string/subjects_scroll_desc">

                        <LinearLayout
                            android:id="@+id/subjectsLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingEnd="16dp">
                            <!-- Subject cards will be added programmatically -->
                        </LinearLayout>
                    </HorizontalScrollView>
                </LinearLayout>

                <!-- Chapters Section -->
                <LinearLayout
                    android:id="@+id/chaptersLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/subjectsTitleContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Chapter title -->
                    <TextView
                        android:id="@+id/chaptersTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chapters"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- Chapter Buttons will be added dynamically -->
                </LinearLayout>

                <!-- Topics Section -->
                <LinearLayout
                    android:id="@+id/topicsLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/chaptersLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Topic title -->
                    <TextView
                        android:id="@+id/topicsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Topics"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:layout_marginBottom="16dp"/>

                    <!-- Topic Buttons will be added dynamically -->
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/subtopicsLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/topicsLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:clipToPadding="false">

                    <!-- Title will be added here programmatically -->

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:fillViewport="true">

                        <GridLayout
                            android:id="@+id/subtopicsGrid"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:rowCount="0"
                            android:padding="8dp"/>
                    </HorizontalScrollView>
                </LinearLayout>




                <!-- Modern Elite Tools Section -->
                <LinearLayout
                    android:id="@+id/additionalButtonsLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@id/subtopicsLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Elite Tools Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Elite Tools"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:fontFamily="@font/montserrat_bold"/>
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See All"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat"/>
                    </LinearLayout>

                    <!-- Elite Tools Grid (2x2) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Top Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <!-- AI Image Generator Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/buttonNew3"
                                android:layout_width="0dp"
                                android:layout_height="160dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/gradient_ai_image_bg"
                                    android:padding="16dp">

                                    <!-- NEW Badge -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentTop="true"
                                        android:layout_alignParentEnd="true"
                                        android:text="NEW"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="#000000"
                                        android:background="@drawable/new_badge_background"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="4dp"/>

                                    <!-- Icon -->
                                    <ImageView
                                        android:id="@+id/aiImageIcon"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:layout_alignParentStart="true"
                                        android:layout_alignParentTop="true"
                                        android:src="@drawable/ic_ai"
                                        android:contentDescription="AI Image Generator"
                                        app:tint="#FFFFFF"/>

                                    <!-- Title -->
                                    <TextView
                                        android:id="@+id/aiImageTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/aiImageIcon"
                                        android:layout_marginTop="16dp"
                                        android:text="AI Image Generator"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:fontFamily="@font/montserrat_bold"/>

                                    <!-- Description -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/aiImageTitle"
                                        android:layout_marginTop="4dp"
                                        android:text="Create &amp; transform images with AI"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp"
                                        android:alpha="0.7"
                                        android:fontFamily="@font/montserrat"/>
                                </RelativeLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Voice Chat Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/buttonNew2"
                                android:layout_width="0dp"
                                android:layout_height="160dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#2A3B4A"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="16dp">

                                    <!-- NEW Badge -->
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_alignParentTop="true"
                                        android:layout_alignParentEnd="true"
                                        android:text="NEW"
                                        android:textSize="12sp"
                                        android:textStyle="bold"
                                        android:textColor="#000000"
                                        android:background="@drawable/new_badge_background"
                                        android:paddingHorizontal="8dp"
                                        android:paddingVertical="4dp"/>

                                    <!-- Icon -->
                                    <ImageView
                                        android:id="@+id/voiceChatIcon"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:layout_alignParentStart="true"
                                        android:layout_alignParentTop="true"
                                        android:src="@drawable/ic_mic"
                                        android:contentDescription="Voice Chat"
                                        app:tint="#FFFFFF"/>

                                    <!-- Title -->
                                    <TextView
                                        android:id="@+id/voiceChatTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/voiceChatIcon"
                                        android:layout_marginTop="16dp"
                                        android:text="Voice Chat"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:fontFamily="@font/montserrat_bold"/>

                                    <!-- Description -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/voiceChatTitle"
                                        android:layout_marginTop="4dp"
                                        android:text="Talk with Chat &amp; Ask AI about anything"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp"
                                        android:alpha="0.7"
                                        android:fontFamily="@font/montserrat"/>
                                </RelativeLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>

                        <!-- Bottom Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Text Extractor Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/buttonNew1"
                                android:layout_width="0dp"
                                android:layout_height="160dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#354555"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="16dp">

                                    <!-- Icon -->
                                    <ImageView
                                        android:id="@+id/textExtractIcon"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:layout_alignParentStart="true"
                                        android:layout_alignParentTop="true"
                                        android:src="@drawable/ic_scan"
                                        android:contentDescription="Text Extractor"
                                        app:tint="#FFFFFF"/>

                                    <!-- Title -->
                                    <TextView
                                        android:id="@+id/textExtractTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/textExtractIcon"
                                        android:layout_marginTop="16dp"
                                        android:text="Text Extractor"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:fontFamily="@font/montserrat_bold"/>

                                    <!-- Description -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/textExtractTitle"
                                        android:layout_marginTop="4dp"
                                        android:text="Extract text from images, PDFs &amp; documents"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp"
                                        android:alpha="0.7"
                                        android:fontFamily="@font/montserrat"/>
                                </RelativeLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Email Assistant Card -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnExtractEmail"
                                android:layout_width="0dp"
                                android:layout_height="160dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="0dp"
                                app:cardBackgroundColor="#2A3B4A"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:padding="16dp">

                                    <!-- Icon -->
                                    <ImageView
                                        android:id="@+id/emailAssistantIcon"
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:layout_alignParentStart="true"
                                        android:layout_alignParentTop="true"
                                        android:src="@drawable/ic_email"
                                        android:contentDescription="Email Assistant"
                                        app:tint="#FFFFFF"/>

                                    <!-- Title -->
                                    <TextView
                                        android:id="@+id/emailAssistantTitle"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/emailAssistantIcon"
                                        android:layout_marginTop="16dp"
                                        android:text="Email Assistant"
                                        android:textColor="#FFFFFF"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:fontFamily="@font/montserrat_bold"/>

                                    <!-- Description -->
                                    <TextView
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:layout_below="@id/emailAssistantTitle"
                                        android:layout_marginTop="4dp"
                                        android:text="Smart email management &amp; responses"
                                        android:textColor="#FFFFFF"
                                        android:textSize="14sp"
                                        android:alpha="0.7"
                                        android:fontFamily="@font/montserrat"/>
                                </RelativeLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
                <!-- Placeholder View -->
                <View
                    android:id="@+id/someOtherView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/additionalButtonsLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- RecyclerView for displaying chat messages -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:scrollbars="vertical"
                    app:layout_constraintTop_toBottomOf="@id/someOtherView"
                    app:layout_constraintBottom_toTopOf="@id/messageInputLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/conversation_background"
                    android:padding="8dp" />

                <!-- Message Input Layout -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/messageInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp">

                    <EditText
                        android:id="@+id/messageEditText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:hint="Write your message"
                        android:inputType="textMultiLine"
                        android:maxLines="8"
                        android:padding="20dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#999999"
                        android:background="@drawable/modern_input_background"
                        android:gravity="start|center_vertical"
                        android:textSize="16sp"
                        android:fontFamily="@font/montserrat"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <!-- Ad Container -->
        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.gms.ads.AdView
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                ads:adSize="LARGE_BANNER"
                ads:adUnitId="ca-app-pub-9180832030816304/6496270014"/>
        </FrameLayout>

        <!-- Fragment Container -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/emailRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="8dp"
            android:clipToPadding="false"
            android:visibility="gone" />  <!-- Initially hidden -->

