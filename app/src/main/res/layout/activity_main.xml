<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:ads="http://schemas.android.com/apk/res-auto">

    <data>
        <!-- Declare any variables here -->
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/ocean_background_gradient"
        android:fitsSystemWindows="false"
        tools:context=".MainActivity">

        <!-- Fixed AI Theme Background (KEEP AS IS) -->
        <ImageView
            android:id="@+id/ai_theme_background"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            android:alpha="0.3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Blended Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/ocean_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@color/ocean_surface"
            android:paddingHorizontal="24dp"
            android:paddingTop="40dp"
            android:paddingBottom="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Hamburger Menu Button -->
            <ImageView
                android:id="@+id/hamburger_menu"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_menu"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/ocean_primary"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- Logo Section -->
            <LinearLayout
                android:id="@+id/logo_section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toEndOf="@id/hamburger_menu"
                app:layout_constraintEnd_toStartOf="@id/profile_icon"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="16dp">

                <!-- Logo Icon -->
                <ImageView
                    android:id="@+id/logo_icon"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/ic_ai"
                    android:layout_marginEnd="12dp"
                    app:tint="@color/ocean_primary" />

                <!-- App Title -->
                <TextView
                    android:id="@+id/app_title_ocean"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Teacher"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/ocean_primary"
                    android:fontFamily="@font/montserrat_bold" />

            </LinearLayout>

            <!-- Profile Icon with Robot View -->
            <ImageView
                android:id="@+id/profile_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ai_robot_icon"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true"
                app:tint="@color/ocean_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- ScrollView to make the content scrollable -->
        <ScrollView
            android:id="@+id/mainScrollView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="false"
            android:background="@android:color/transparent"
            android:padding="8dp"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/ocean_header"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Non-chat elements -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/non_chat_elements"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:background="@android:color/transparent"
                tools:context=".MainActivity">


                <!-- Premium Banner -->
                <com.playstudio.aiteacher.GradientButton
                    android:id="@+id/buyButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="UNLOCK PREMIUM\nRemove Ads • GET All AI Models - More accurate responses + Image generator • unlimited chat"
                    android:textColor="@color/ocean_text_dark"
                    android:textSize="18sp"
                    android:letterSpacing="0.03"
                    android:lineSpacingExtra="2sp"
                    android:fontFamily="@font/montserrat_bold"
                    android:gravity="center"
                    android:padding="24dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginHorizontal="24dp"
                    android:elevation="12dp"
                    android:stateListAnimator="@null"
                    android:outlineProvider="background"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintWidth_percent="0.9"
                    app:buttonCornerRadius="16dp"
                    android:textAllCaps="false"
                    android:shadowColor="@color/shadow_medium"
                    android:shadowDx="2"
                    android:shadowDy="2"
                    android:shadowRadius="4"
                    app:startColor="@color/ocean_primary"
                    app:endColor="@color/ocean_primary_light"
                    app:strokeWidth="2dp"
                    app:strokeColor="@color/ocean_text_dark"/>



                <!-- Quick Actions Section -->
                <LinearLayout
                    android:id="@+id/quickActionsContainer"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    app:layout_constraintTop_toBottomOf="@id/buyButton"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Category Tabs -->
                    <HorizontalScrollView
                        android:id="@+id/category_tabs_scroll"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none"
                        android:layout_marginBottom="20dp">

                        <LinearLayout
                            android:id="@+id/category_tabs_container"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="8dp">

                            <TextView
                                android:id="@+id/tab_all_tools"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="All Tools"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:textColor="@color/ocean_text_dark"
                                android:fontFamily="@font/montserrat"
                                android:background="@drawable/category_tab_background"
                                android:padding="12dp"
                                android:layout_marginEnd="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground" />

                            <TextView
                                android:id="@+id/tab_creative"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Creative"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:textColor="@color/ocean_text_secondary"
                                android:fontFamily="@font/montserrat"
                                android:background="@drawable/category_tab_inactive_background"
                                android:padding="12dp"
                                android:layout_marginEnd="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground" />

                            <TextView
                                android:id="@+id/tab_academic"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Academic"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:textColor="@color/ocean_text_secondary"
                                android:fontFamily="@font/montserrat"
                                android:background="@drawable/category_tab_inactive_background"
                                android:padding="12dp"
                                android:layout_marginEnd="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground" />

                            <TextView
                                android:id="@+id/tab_productivity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Productivity"
                                android:textSize="14sp"
                                android:textStyle="normal"
                                android:textColor="@color/ocean_text_secondary"
                                android:fontFamily="@font/montserrat"
                                android:background="@drawable/category_tab_inactive_background"
                                android:padding="12dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground" />

                        </LinearLayout>
                    </HorizontalScrollView>

                    <!-- Quick Actions Title -->
                    <TextView
                        android:id="@+id/quickActionsTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quick Actions"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/ocean_text_primary"
                        android:fontFamily="@font/montserrat_bold"
                        android:layout_marginBottom="16dp" />


                    <!-- AI Image Generator (Large Card) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/buttonNew3"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/floating_card_primary"
                            android:padding="20dp">

                            <!-- NEW Badge -->
                            <TextView
                                android:id="@+id/new_badge_1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEW"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/ocean_text_primary"
                                android:background="@color/ocean_accent_coral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <!-- Tool Icon -->
                            <ImageView
                                android:id="@+id/aiImageIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_ai"
                                app:tint="@color/ocean_text_primary"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <!-- Content -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/new_badge_1"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="AI Image Generator"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/ocean_text_primary"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Create &amp; transform images with AI"
                                    android:textSize="14sp"
                                    android:textColor="@color/ocean_text_secondary"
                                    android:fontFamily="@font/montserrat" />

                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Voice Chat (Large Card) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/buttonNew2"
                        android:layout_width="match_parent"
                        android:layout_height="140dp"
                        android:layout_marginBottom="16dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?android:attr/selectableItemBackground">

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/floating_card_secondary"
                            android:padding="20dp">

                            <!-- NEW Badge -->
                            <TextView
                                android:id="@+id/new_badge_2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="NEW"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                android:textColor="@color/ocean_text_primary"
                                android:background="@color/ocean_accent_coral"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="4dp"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintEnd_toEndOf="parent" />

                            <!-- Notification Dot -->
                            <View
                                android:layout_width="8dp"
                                android:layout_height="8dp"
                                android:background="@color/ocean_notification"
                                app:layout_constraintTop_toBottomOf="@id/new_badge_2"
                                app:layout_constraintEnd_toEndOf="parent"
                                android:layout_marginTop="8dp" />

                            <!-- Tool Icon -->
                            <ImageView
                                android:id="@+id/voiceChatIcon"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/ocean_text_primary"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />

                            <!-- Content -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toStartOf="@id/new_badge_2"
                                app:layout_constraintBottom_toBottomOf="parent">

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Voice Chat"
                                    android:textSize="18sp"
                                    android:textStyle="bold"
                                    android:textColor="@color/ocean_text_primary"
                                    android:fontFamily="@font/montserrat_bold"
                                    android:layout_marginBottom="6dp" />

                                <TextView
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:text="Talk with Chat &amp; Ask AI about anything"
                                    android:textSize="14sp"
                                    android:textColor="@color/ocean_text_secondary"
                                    android:fontFamily="@font/montserrat" />

                            </LinearLayout>

                        </androidx.constraintlayout.widget.ConstraintLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

                <!-- Academic Content Hidden - Chapters, Topics, Subtopics moved to Academic button functionality -->
                <LinearLayout
                    android:id="@+id/chaptersLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/quickActionsContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/chaptersTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Chapters"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/topicsLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/chaptersLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/topicsTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Topics"
                        android:textColor="#FFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@font/montserrat_bold"
                        android:layout_marginBottom="16dp"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/subtopicsLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/topicsLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:clipToPadding="false">

                    <GridLayout
                        android:id="@+id/subtopicsGrid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:columnCount="2"
                        android:rowCount="0"
                        android:padding="8dp"/>
                </LinearLayout>

                <!-- Modern Elite Tools Section -->
                <LinearLayout
                    android:id="@+id/additionalButtonsLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    app:layout_constraintTop_toBottomOf="@id/quickActionsContainer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Elite Tools Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Elite Tools"
                            android:textColor="#FFFFFF"
                            android:textSize="22sp"
                            android:fontFamily="@font/montserrat_bold"/>
                        
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="See All"
                            android:textColor="#666666"
                            android:textSize="14sp"
                            android:fontFamily="@font/montserrat"/>
                    </LinearLayout>

                    <!-- Elite Tools Grid (2x2) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Top Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="16dp">

                            <!-- Math Tool -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardAnalyzeImage"
                                android:layout_width="0dp"
                                android:layout_height="120dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/floating_card_background"
                                    android:padding="16dp"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_scan"
                                        app:tint="@color/ocean_text_primary"
                                        android:layout_marginBottom="12dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Analyze Image"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/ocean_text_primary"
                                        android:fontFamily="@font/montserrat_bold"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="AI image analysis"
                                        android:textSize="12sp"
                                        android:textColor="@color/ocean_text_secondary"
                                        android:gravity="center"
                                        android:fontFamily="@font/montserrat" />

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Science Tool -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardScienceTool"
                                android:layout_width="0dp"
                                android:layout_height="120dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/floating_card_background"
                                    android:padding="16dp"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_info"
                                        app:tint="@color/ocean_text_primary"
                                        android:layout_marginBottom="12dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Science"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/ocean_text_primary"
                                        android:fontFamily="@font/montserrat_bold"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Scientific analysis"
                                        android:textSize="12sp"
                                        android:textColor="@color/ocean_text_secondary"
                                        android:gravity="center"
                                        android:fontFamily="@font/montserrat" />

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                        </LinearLayout>

                        <!-- Bottom Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Text Extractor -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardHomeworkHelper"
                                android:layout_width="0dp"
                                android:layout_height="120dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/floating_card_background"
                                    android:padding="16dp"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_baseline_article_24"
                                        app:tint="@color/ocean_text_primary"
                                        android:layout_marginBottom="12dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Homework Helper"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/ocean_text_primary"
                                        android:fontFamily="@font/montserrat_bold"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Extract text from docs"
                                        android:textSize="12sp"
                                        android:textColor="@color/ocean_text_secondary"
                                        android:gravity="center"
                                        android:fontFamily="@font/montserrat" />

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>

                            <!-- Email Assistant -->
                            <androidx.cardview.widget.CardView
                                android:id="@+id/btnExtractEmail"
                                android:layout_width="0dp"
                                android:layout_height="120dp"
                                android:layout_weight="1"
                                android:layout_marginStart="8dp"
                                app:cardCornerRadius="16dp"
                                app:cardElevation="8dp"
                                android:clickable="true"
                                android:focusable="true"
                                android:foreground="?android:attr/selectableItemBackground">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/floating_card_background"
                                    android:padding="16dp"
                                    android:orientation="vertical"
                                    android:gravity="center">

                                    <ImageView
                                        android:layout_width="32dp"
                                        android:layout_height="32dp"
                                        android:src="@drawable/ic_email"
                                        app:tint="@color/ocean_text_primary"
                                        android:layout_marginBottom="12dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Email Assistant"
                                        android:textSize="16sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/ocean_text_primary"
                                        android:fontFamily="@font/montserrat_bold"
                                        android:layout_marginBottom="4dp" />

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Smart responses"
                                        android:textSize="12sp"
                                        android:textColor="@color/ocean_text_secondary"
                                        android:gravity="center"
                                        android:fontFamily="@font/montserrat" />

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Bottom Spacer for content -->
                <View
                    android:id="@+id/content_bottom_spacer"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    app:layout_constraintTop_toBottomOf="@id/additionalButtonsLayout"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent" />

                <!-- Chat UI is hidden in MainActivity - it's handled by ChatFragment -->
                <View
                    android:id="@+id/chat_placeholder"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone"
                    app:layout_constraintTop_toBottomOf="@id/content_bottom_spacer"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <!-- Floating Action Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/floating_action_button"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="120dp"
            android:backgroundTint="@color/ocean_accent_coral"
            android:src="@drawable/ic_lightning"
            app:tint="@color/ocean_text_primary"
            app:elevation="8dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav" />

        <!-- Bottom Navigation Bar - Chat Input -->
        <LinearLayout
            android:id="@+id/bottom_nav"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bottom_nav_background"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="visible"
            app:layout_constraintBottom_toTopOf="@id/adContainer"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <EditText
                android:id="@+id/search_bar"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/search_bar_background"
                android:hint="Write your message"
                android:textColorHint="@color/ocean_text_secondary"
                android:textColor="@color/ocean_text_primary"
                android:textSize="16sp"
                android:fontFamily="@font/montserrat"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:imeOptions="actionSend"
                android:inputType="textMultiLine|textCapSentences" />

        </LinearLayout>

        <!-- Ad Container -->
        <FrameLayout
            android:id="@+id/adContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.gms.ads.AdView
                android:id="@+id/adView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                ads:adSize="LARGE_BANNER"
                ads:adUnitId="ca-app-pub-9180832030816304/6496270014"/>
        </FrameLayout>

        <!-- Fragment Container - Only visible when showing fragments -->
        <FrameLayout
            android:id="@+id/fragment_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Subjects Layout (hidden compatibility) - REMOVED -->

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/emailRecyclerView"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:padding="8dp"
            android:clipToPadding="false"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/ocean_header"
            app:layout_constraintBottom_toTopOf="@id/bottom_nav"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>