<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="4dp"
    android:background="@drawable/rounded_corners"
    android:backgroundTint="@color/glass_text_secondary"
    android:alpha="1.0">

    <!-- Chat Icon -->
    <ImageView
        android:id="@+id/chatIconImageView"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chat"
        app:tint="@color/glass_accent"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="8dp" />

    <!-- Chat Content -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chatTitleText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="How to learn React"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="@color/glass_text_primary"
            android:maxLines="1"
            android:ellipsize="end" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="2dp">

            <TextView
                android:id="@+id/chatPreviewText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="What are the best resources for..."
                android:textSize="10sp"
                android:textColor="@color/glass_text_secondary"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/chatModelBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-4"
                android:textSize="8sp"
                android:textStyle="bold"
                android:textColor="@color/glass_accent"
                android:background="@drawable/rounded_corners"
                android:backgroundTint="@color/glass_accent"
                android:alpha="0.2"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Time and Arrow -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp">

        <TextView
            android:id="@+id/chatTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="2h"
            android:textSize="8sp"
            android:textColor="@color/glass_text_secondary"
            android:gravity="center" />

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/glass_text_secondary"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>