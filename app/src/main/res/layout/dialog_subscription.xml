<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/premium_dialog_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Main dialog container  -->
        <LinearLayout
            android:id="@+id/dialogLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/premium_dialog_background"
            android:padding="24dp"
            android:elevation="8dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingBottom="16dp">

                <com.airbnb.lottie.LottieAnimationView
                    android:id="@+id/lottieAnimationView"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    app:lottie_rawRes="@raw/sparkles"
                    app:lottie_autoPlay="true"
                    app:lottie_loop="true"
                    app:tint="@color/premium_gold"/>

                <TextView
                    android:id="@+id/dialogTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:text="🚀 Choose Your AI Power Level"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/premium_gold"
                    android:letterSpacing="0.02"/>
            </LinearLayout>

            <!-- FREE TIER -->
            <LinearLayout
                android:id="@+id/freeSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/subscription_option_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_free_tier"
                        app:tint="@color/premium_gold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Free Tier"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/freePrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$0/month"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/premium_gold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:id="@+id/freeDescription"
                    android:text=""
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/white_70"
                    android:lineSpacingExtra="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🆓 GET STARTED"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/premium_gold"
                    android:background="@drawable/popular_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <!-- BASIC TIER -->
            <LinearLayout
                android:id="@+id/basicSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/subscription_option_unselected"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_bronze_crown"
                        app:tint="@color/premium_gold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Essential Plan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/basicPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$9.99/month"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/premium_gold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:id="@+id/basicDescription"
                    android:text=""
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/white_70"
                    android:lineSpacingExtra="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🎯 STARTER PACK"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/premium_gold"
                    android:background="@drawable/popular_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <!-- PRO TIER -->
            <LinearLayout
                android:id="@+id/proSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/subscription_option_popular"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_silver_crown"
                        app:tint="@color/premium_gold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Professional Plan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/proPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$39.99/month"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/premium_gold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:id="@+id/proDescription"
                    android:text=""
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/white_70"
                    android:lineSpacingExtra="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🔥 MOST POPULAR"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/premium_gold"
                    android:background="@drawable/popular_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <!-- PREMIUM TIER -->
            <LinearLayout
                android:id="@+id/premiumSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/subscription_option_best_value"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_gold_crown"
                        app:tint="@color/premium_gold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Premium Plan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/premiumPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$79.99/month"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/premium_gold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:id="@+id/premiumDescription"
                    android:text=""
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/white_70"
                    android:lineSpacingExtra="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="💎 BEST VALUE"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/premium_gold"
                    android:background="@drawable/savings_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <!-- ULTRA PREMIUM TIER -->
            <LinearLayout
                android:id="@+id/ultraSubscription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/subscription_option_best_value"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_premium_crown"
                        app:tint="@color/premium_gold"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="Enterprise Max"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/ultraPrice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="$299.99/month"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="@font/montserrat_bold"
                        android:textColor="@color/premium_gold"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:id="@+id/ultraDescription"
                    android:text=""
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat_medium"
                    android:textColor="@color/white_70"
                    android:lineSpacingExtra="2dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="🚀 ULTIMATE POWER"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat_bold"
                    android:textColor="@color/premium_gold"
                    android:background="@drawable/savings_badge"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="2dp"/>
            </LinearLayout>

            <!-- Cost protection notice -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️ Token-based system: All models available. Tokens deducted based on model and response length."
                android:textSize="12sp"
                android:fontFamily="@font/montserrat_medium"
                android:textColor="@color/white_70"
                android:gravity="center"
                android:padding="8dp"
                android:background="@drawable/guarantee_background"
                android:layout_marginBottom="16dp"/>
        </LinearLayout>

        <!-- Big Buy Button  -->
        <Button
            android:id="@+id/btnBuy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔥 UPGRADE NOW"
            android:textSize="18sp"
            android:textStyle="bold"
            android:fontFamily="@font/montserrat_bold"
            android:textAllCaps="true"
            android:letterSpacing="0.03"
            android:paddingVertical="18dp"
            android:background="@drawable/button_premium_gradient"
            android:textColor="@color/white"
            android:layout_marginTop="16dp"
            android:enabled="false"
            android:visibility="visible"/>
            
        <!-- Subscription Status Text -->
        <TextView
            android:id="@+id/tv_subscription_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Free Plan - 1,000 tokens/day (3x markup)"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/white_70"
            android:gravity="center"
            android:paddingVertical="8dp"
            android:layout_marginTop="8dp"
            android:visibility="gone"/>

        <!-- Secondary action  -->
        <TextView
            android:id="@+id/btnClose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Continue with Free"
            android:textSize="14sp"
            android:fontFamily="@font/montserrat_medium"
            android:textColor="@color/white_70"
            android:gravity="center"
            android:paddingVertical="12dp"
            android:layout_marginTop="8dp"/>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>