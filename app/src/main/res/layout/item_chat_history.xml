<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/glass_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- Selection Indicator -->
            <View
                android:id="@+id/selectionIndicator"
                android:layout_width="4dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="12dp"
                android:background="@color/glass_accent"
                android:visibility="gone" />

            <!-- Title and Timestamp -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chat Title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_text_primary"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/timestampText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Jan 15, 2024"
                    android:textSize="12sp"
                    android:textColor="@color/glass_text_secondary"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Favorite Icon -->
            <ImageView
                android:id="@+id/favoriteIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_star_outline"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                app:tint="@color/glass_accent" />

        </LinearLayout>

        <!-- Preview Text -->
        <TextView
            android:id="@+id/previewText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Last message preview..."
            android:textSize="14sp"
            android:textColor="@color/glass_text_secondary"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp" />

        <!-- Footer Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Model Badge -->
            <TextView
                android:id="@+id/modelBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GPT-4"
                android:textSize="10sp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:background="@drawable/badge_background"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp" />

            <!-- Category Badge -->
            <TextView
                android:id="@+id/categoryBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="General"
                android:textSize="10sp"
                android:textColor="@color/glass_text_primary"
                android:textStyle="bold"
                android:background="@drawable/badge_background_upgraded"
                android:paddingHorizontal="8dp"
                android:paddingVertical="2dp"
                android:layout_marginEnd="8dp" />

            <!-- Spacer -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Message Count -->
            <TextView
                android:id="@+id/messageCountText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12 messages"
                android:textSize="10sp"
                android:textColor="@color/glass_text_secondary"
                android:drawableStart="@drawable/ic_baseline_article_24"
                android:drawablePadding="4dp"
                app:drawableTint="@color/glass_text_secondary" />

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>