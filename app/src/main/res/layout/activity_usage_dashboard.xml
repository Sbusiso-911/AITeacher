<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/colorPrimary">

        <TextView
            android:id="@+id/text_view_current_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Current Plan: FREE"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:gravity="center" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/text_view_total_models"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Available Models: 0"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_view_total_used"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Used: 0"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_view_total_remaining"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Remaining: 0"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/text_view_credit_balance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Credits: 0.00"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:gravity="center" />

        </LinearLayout>

    </LinearLayout>

    <!-- Usage List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycler_view_usage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:padding="8dp"
        android:clipToPadding="false" />

    <!-- Upgrade Button -->
    <Button
        android:id="@+id/button_upgrade"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:text="Upgrade for More Usage"
        android:textColor="@color/white"
        android:background="@color/colorAccent"
        android:padding="12dp"
        android:textSize="16sp"
        android:textStyle="bold" />

</LinearLayout>