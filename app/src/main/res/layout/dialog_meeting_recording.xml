<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@drawable/glassmorphism_input_background"
    android:elevation="8dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Meeting Recording"
            android:textColor="@color/glass_text_primary"
            android:textSize="20sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium" />

        <Button
            android:id="@+id/dismissButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✕"
            android:textColor="@color/glass_text_secondary"
            android:textSize="16sp"
            android:background="@drawable/glassmorphism_circle_button"
            android:contentDescription="Close dialog" />
    </LinearLayout>

    <!-- Recording Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="16dp"
        android:background="@drawable/glassmorphism_button_background"
        android:layout_marginBottom="16dp">

        <!-- Timer Display -->
        <TextView
            android:id="@+id/timerText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00:00"
            android:textColor="@color/glass_text_primary"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <!-- Status Text -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to record"
            android:textColor="@color/glass_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />

        <!-- Recording Animation -->
        <View
            android:id="@+id/recordingIndicator"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:background="@drawable/glassmorphism_circle_button"
            android:layout_marginTop="8dp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Control Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="16dp">

        <!-- Start/Stop Recording Button -->
        <Button
            android:id="@+id/startStopRecordingButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Start Recording"
            android:textColor="@color/glass_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/glassmorphism_button_primary"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:layout_marginEnd="12dp"
            android:minWidth="140dp" />

        <!-- Pause/Resume Button -->
        <Button
            android:id="@+id/pauseResumeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pause"
            android:textColor="@color/glass_text_primary"
            android:textSize="16sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/glassmorphism_button_background"
            android:paddingHorizontal="24dp"
            android:paddingVertical="12dp"
            android:visibility="gone"
            android:minWidth="100dp" />
    </LinearLayout>

    <!-- Recording Info -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@drawable/glassmorphism_button_background"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Meeting Recording Features:"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• High-quality audio recording (up to 1 hour)"
            android:textColor="@color/glass_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• AI-powered transcription and analysis"
            android:textColor="@color/glass_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Auto-generated summaries and action items"
            android:textColor="@color/glass_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="2dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Export transcripts and meeting minutes"
            android:textColor="@color/glass_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">

        <Button
            android:id="@+id/importFileButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Import File"
            android:textColor="@color/glass_text_secondary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/glassmorphism_button_background"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp"
            android:layout_marginEnd="12dp" />

        <Button
            android:id="@+id/doneButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Done"
            android:textColor="@color/glass_text_primary"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:background="@drawable/glassmorphism_button_primary"
            android:paddingHorizontal="20dp"
            android:paddingVertical="10dp"
            android:visibility="gone" />
    </LinearLayout>

</LinearLayout>