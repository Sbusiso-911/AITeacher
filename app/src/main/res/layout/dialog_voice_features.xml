<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp"
    android:background="@drawable/glassmorphism_input_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Audio &amp; Voice Features"
            android:textColor="@color/glass_text_primary"
            android:textSize="18sp"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:padding="16dp"
            android:background="@drawable/glassmorphism_button_background"
            android:layout_marginBottom="16dp" />

        <!-- Audio Controls -->
        <com.playstudio.aiteacher.AudioControlsView
            android:id="@+id/audio_controls_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp" />

        <!-- Features Description -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/glassmorphism_button_background">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Audio Capabilities:"
                android:textColor="@color/glass_text_primary"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Voice Input - Record your questions and messages"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Audio Output - AI responds with natural speech"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Realtime Models - Low-latency voice conversation"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• 6 Different Voices - Choose your preferred AI voice"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="• Auto-Transcription - Speech converted to text"
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="8dp" />

        </LinearLayout>

        <!-- Subscription Notice (if applicable) -->
        <LinearLayout
            android:id="@+id/subscription_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/glassmorphism_button_background"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Premium Audio Features"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Advanced audio models and realtime features require a subscription upgrade."
                android:textColor="@color/glass_text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>