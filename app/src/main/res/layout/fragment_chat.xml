<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <!-- Declare any variables here -->
    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/chatFragmentBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="16dp"
        android:background="@color/md_theme_light_background"
        tools:context=".ChatFragment"
        android:contentDescription="@string/chat_fragment_background">

        <!-- Loading overlay with calming color -->
        <View
            android:id="@+id/loadingOverlay"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="#8067A9C0"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- AI Robot Loading Animation -->
        <ImageView
            android:id="@+id/aiRobotLoader"
            android:layout_width="120dp"
            android:layout_height="140dp"
            android:src="@drawable/ai_robot_animated"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
            
        <!-- Centered ProgressBar with AI Robot colors -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateTint="@color/ai_robot_primary"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:visibility="gone"
            android:contentDescription="@string/loading_progress_desc"/>

        <!-- Top App Bar like the HTML demo -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/topAppBar"
            android:layout_width="0dp"
            android:layout_height="@dimen/app_bar_height"
            android:background="@drawable/bg_app_bar_material3"
            android:elevation="@dimen/elevation_medium"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Left Actions: Hamburger Menu + Title -->
            <LinearLayout
                android:id="@+id/leftActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginStart="@dimen/spacing_md">

                <!-- Hamburger Menu Button -->
                <Button
                    android:id="@+id/hamburgerMenuButton"
                    style="@style/IconButtonMaterial3"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:text="&#9776;"
                    android:textSize="18sp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:contentDescription="Menu" />

                <!-- Back Button (initially hidden) -->
                <Button
                    android:id="@+id/backButton"
                    style="@style/IconButtonMaterial3"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:text="&#8592;"
                    android:textSize="18sp"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:visibility="gone"
                    android:contentDescription="Back" />

                <!-- App Title -->
                <TextView
                    android:id="@+id/appTitle"
                    style="@style/AppBarTitleMaterial3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Teacher"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat"
                    android:layout_marginStart="@dimen/spacing_sm" />

            </LinearLayout>

            <!-- Right Action Buttons: History, Models, Tier, Share (as in HTML demo) -->
            <LinearLayout
                android:id="@+id/topActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_marginEnd="@dimen/spacing_md">

                <!-- History Button -->
                <Button
                    android:id="@+id/historyButton"
                    style="@style/IconButtonMaterial3"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:text="&#128203;"
                    android:textSize="18sp"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:contentDescription="History" />

                <!-- AI Models Button -->
                <Button
                    android:id="@+id/activeModelButton"
                    style="@style/IconButtonMaterial3"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:text="&#129302;"
                    android:textSize="18sp"
                    android:layout_marginEnd="@dimen/spacing_xs"
                    android:contentDescription="AI Models" />

                <!-- Current Tier Button with Badge (as in HTML demo) -->
                <FrameLayout
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:layout_marginEnd="@dimen/spacing_xs">

                    <Button
                        android:id="@+id/tierButton"
                        style="@style/IconButtonMaterial3"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="&#128081;"
                        android:textSize="18sp"
                        android:contentDescription="Current Tier" />

                    <TextView
                        android:id="@+id/tierBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO"
                        android:textSize="8sp"
                        android:textColor="@android:color/white"
                        android:background="@drawable/new_badge_background"
                        android:paddingHorizontal="4dp"
                        android:paddingVertical="1dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="-2dp"
                        android:layout_marginEnd="-2dp" />
                </FrameLayout>

                <!-- Share button moved to chat messages for better UX -->
                <!-- <Button
                    android:id="@+id/shareButton"
                    style="@style/IconButtonMaterial3"
                    android:layout_width="@dimen/icon_button_size"
                    android:layout_height="@dimen/icon_button_size"
                    android:text="&#128228;"
                    android:textSize="18sp"
                    android:contentDescription="Share" /> -->

                <!-- Hidden elements for compatibility -->
                <TextView
                    android:id="@+id/subscriptionStatusText"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/startComputerUseButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/shareButton"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:visibility="gone" />

            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Daily credit balance -->
        <TextView
            android:id="@+id/tv_credit_balance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Credits: 0.00/0.00"
            android:textSize="12sp"
            android:textColor="@color/md_theme_light_on_surface"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/topAppBar"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Image editing controls -->
        <LinearLayout
            android:id="@+id/imageEditControls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="@drawable/glassmorphism_button_background"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/tv_credit_balance"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="@string/image_edit_controls">

            <!-- Image preview -->
            <ImageView
                android:id="@+id/uploadedImageView"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:scaleType="centerCrop"
                android:contentDescription="@string/uploaded_image_desc"
                android:layout_marginTop="8dp"
                android:visibility="gone"
                android:background="@color/trust_blue_light" />

            <!-- Text extraction progress -->
            <ProgressBar
                android:id="@+id/textExtractionProgress"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/trust_blue_dark"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/textExtractionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Extracting text..."
                android:textColor="@color/glass_text_primary"
                android:textSize="16sp"
                android:fontFamily="sans-serif-medium"
                android:visibility="gone"
                android:layout_gravity="center"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Chat messages area -->
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintTop_toBottomOf="@id/imageEditControls"
            app:layout_constraintBottom_toTopOf="@id/messageInputLayout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:orientation="vertical"
            android:padding="16dp"
            android:contentDescription="@string/chat_linear_layout_desc">

            <!-- Chat messages RecyclerView -->
            <LinearLayout
                android:id="@+id/imageContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glassmorphism_button_background"
                android:contentDescription="@string/image_container_desc"
                android:orientation="vertical"
                android:padding="16dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/generatedImageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:adjustViewBounds="true"
                    android:contentDescription="@string/generated_image_desc"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/generatingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:contentDescription="@string/generating_text_desc"
                    android:fontFamily="sans-serif-medium"
                    android:padding="16dp"
                    android:text="Generating..."
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/downloadButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:background="@drawable/glassmorphism_button_primary"
                    android:contentDescription="@string/download_button_desc"
                    android:fontFamily="sans-serif-medium"
                    android:padding="16dp"
                    android:text="Download Image"
                    android:textColor="@color/glass_text_primary"
                    android:visibility="gone" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:scrollbars="vertical"
                android:layout_marginBottom="8dp"
                android:contentDescription="@string/chat_messages_list" />

            <!-- Follow-up questions section -->
            <HorizontalScrollView
                android:id="@+id/followUpQuestionsScrollView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:scrollbars="none"
                android:paddingVertical="@dimen/spacing_sm"
                android:contentDescription="Follow-up questions">

                <LinearLayout
                    android:id="@+id/followUpQuestionsContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="@dimen/spacing_md"
                    android:paddingVertical="@dimen/spacing_sm" />
            </HorizontalScrollView>

            <!-- Generated images section -->
        </LinearLayout>

        <!-- Input Area matching HTML demo -->
        <LinearLayout
            android:id="@+id/messageInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@color/md_theme_light_surface"
            android:paddingTop="@dimen/spacing_md"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Main Input Container -->
            <LinearLayout
                android:id="@+id/messageInputContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_input_field_material3"
                android:layout_marginHorizontal="@dimen/spacing_md"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingVertical="@dimen/spacing_sm"
                android:gravity="center_vertical"
                android:minHeight="@dimen/input_area_height">

                <!-- Input Actions (Voice, Camera) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginEnd="@dimen/spacing_sm">

                    <Button
                        android:id="@+id/voiceInputButton"
                        style="@style/IconButtonMaterial3"
                        android:layout_width="@dimen/input_button_size"
                        android:layout_height="@dimen/input_button_size"
                        android:text="&#127908;"
                        android:textSize="18sp"
                        android:layout_marginEnd="@dimen/spacing_xs"
                        android:contentDescription="Voice Input" />

                    <Button
                        android:id="@+id/scanTextButton"
                        style="@style/IconButtonMaterial3"
                        android:layout_width="@dimen/input_button_size"
                        android:layout_height="@dimen/input_button_size"
                        android:text="&#128247;"
                        android:textSize="18sp"
                        android:contentDescription="Camera" />
                </LinearLayout>

                <!-- Message Input Field -->
                <EditText
                    android:id="@+id/messageEditText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:hint="Message AI Teacher..."
                    android:textColor="@color/md_theme_light_on_surface"
                    android:textColorHint="@color/md_theme_light_on_surface_variant"
                    android:textSize="16sp"
                    android:fontFamily="@font/montserrat"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="6"
                    android:minHeight="24dp"
                    android:gravity="top"
                    android:scrollHorizontally="false"
                    android:layout_marginHorizontal="@dimen/spacing_sm" />

                <!-- Send Button -->
                <Button
                    android:id="@+id/sendButton"
                    style="@style/SendButtonMaterial3"
                    android:layout_width="@dimen/input_button_size"
                    android:layout_height="@dimen/input_button_size"
                    android:text="&#10148;"
                    android:textSize="18sp"
                    android:textColor="@android:color/white"
                    android:enabled="false"
                    android:contentDescription="Send message" />
            </LinearLayout>

            <!-- Secondary Actions (Record Meeting & Live Chat) -->
            <LinearLayout
                android:id="@+id/secondaryActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:paddingHorizontal="@dimen/spacing_md"
                android:paddingTop="@dimen/spacing_sm">

                <!-- Record Meeting Button -->
                <Button
                    android:id="@+id/meetingRecordButton"
                    style="@style/ToggleButtonMaterial3"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/spacing_sm"
                    android:text="🔴 Record Meeting"
                    android:textSize="13sp"
                    android:fontFamily="@font/montserrat"
                    android:contentDescription="Record Meeting" />

                <!-- Live Chat Button -->
                <Button
                    android:id="@+id/realtimeVoiceButton"
                    style="@style/ToggleButtonMaterial3"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/spacing_sm"
                    android:text="🟢 Live Chat"
                    android:textSize="13sp"
                    android:fontFamily="@font/montserrat"
                    android:contentDescription="Live Chat" />

            </LinearLayout>
        </LinearLayout>

        <!-- Subscription overlay with calming semi-transparent blue -->
        <View
            android:id="@+id/subscriptionOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#8067A9C0"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <TextView
            android:id="@+id/recordingStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Recording meeting..."
            android:textColor="@color/white"
            android:background="@color/trust_blue_semi_transparent"
            android:padding="8dp"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp"/>

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:autoLink="web"
            android:linksClickable="true"
            android:textIsSelectable="true"/>

        <!-- OpenAI Live Audio Controls -->
        <LinearLayout
            android:id="@+id/openai_live_audio_controls"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="8dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/messageInputLayout"
            android:layout_marginBottom="8dp"
            android:contentDescription="@string/openai_controls_container">

            <Button
                android:id="@+id/openAISessionButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openai_start_session"
                android:contentDescription="@string/openai_start_session_desc"
                style="@style/AppButton"
                android:layout_marginBottom="8dp"/>

            <Button
                android:id="@+id/openAISignalTurnEndButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/openai_end_turn"
                android:contentDescription="@string/openai_end_turn_desc"
                style="@style/AppButton.Secondary"
                android:visibility="gone"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/openAIStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/openai_status_idle"
                android:gravity="center"
                android:padding="4dp"
                android:textColor="@color/glass_text_primary"
                android:fontFamily="sans-serif-medium"
                android:contentDescription="@string/openai_status_desc"/>

            <TextView
                android:id="@+id/openAIAiResponseTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="50dp"
                android:gravity="start|top"
                android:padding="8dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/glassmorphism_button_background"
                android:textColor="@color/glass_text_primary"
                android:textIsSelectable="true"
                android:contentDescription="@string/openai_response_desc"/>
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>