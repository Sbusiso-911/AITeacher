<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glassmorphism_chat_background"
    android:padding="24dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">
        
        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_premium_theme"
            android:layout_marginEnd="12dp"
            app:tint="@color/quantum_primary" />
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Theme Selection"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:fontFamily="@font/montserrat" />
        
        <ImageView
            android:id="@+id/btnCloseThemeDialog"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_dismiss"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            app:tint="@android:color/white" />
        
    </LinearLayout>

    <!-- Theme Description -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Choose your AI visualization style. Premium themes offer advanced animations and effects."
        android:textSize="14sp"
        android:textColor="@color/quantum_accent"
        android:layout_marginBottom="20dp"
        android:fontFamily="@font/montserrat" />

    <!-- Theme Grid -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewThemes"
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginBottom="20dp"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2" />

    <!-- Preview Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glassmorphism_input_background"
        android:padding="16dp"
        android:layout_marginBottom="16dp">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Preview"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/montserrat" />
        
        <ImageView
            android:id="@+id/imageViewThemePreview"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:scaleType="centerCrop"
            android:background="@drawable/glassmorphism_message_received"
            android:contentDescription="Theme preview" />
        
        <TextView
            android:id="@+id/textViewThemeDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select a theme to see preview"
            android:textSize="12sp"
            android:textColor="@color/quantum_accent"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/montserrat" />
        
    </LinearLayout>

    <!-- Settings -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/glassmorphism_input_background"
        android:padding="16dp"
        android:layout_marginBottom="20dp">
        
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Animation Settings"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginBottom="12dp"
            android:fontFamily="@font/montserrat" />
        
        <!-- Enable Animations -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable Animations"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/montserrat" />
            
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnableAnimations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/quantum_primary"
                app:trackTint="@color/quantum_primary_30" />
            
        </LinearLayout>
        
        <!-- Animation Quality -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Animation Quality"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/montserrat" />
            
            <Spinner
                android:id="@+id/spinnerAnimationQuality"
                android:layout_width="120dp"
                android:layout_height="wrap_content"
                android:entries="@array/animation_quality_options"
                android:background="@drawable/glassmorphism_button_background" />
            
        </LinearLayout>
        
        <!-- Enable Particles -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Enable Particles"
                android:textSize="14sp"
                android:textColor="@android:color/white"
                android:fontFamily="@font/montserrat" />
            
            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchEnableParticles"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="@color/quantum_secondary"
                app:trackTint="@color/quantum_secondary_30" />
            
        </LinearLayout>
        
    </LinearLayout>

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end">
        
        <Button
            android:id="@+id/btnCancelThemeSelection"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Cancel"
            android:textColor="@android:color/white"
            android:background="@drawable/glassmorphism_button_background"
            android:layout_marginEnd="12dp"
            android:paddingHorizontal="20dp"
            android:fontFamily="@font/montserrat" />
        
        <Button
            android:id="@+id/btnApplyTheme"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:text="Apply Theme"
            android:textColor="@android:color/white"
            android:background="@drawable/glassmorphism_button_primary"
            android:paddingHorizontal="24dp"
            android:fontFamily="@font/montserrat" />
        
    </LinearLayout>

</LinearLayout>