<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/ai_circuit_background"
    tools:context=".profile.ProfileActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- AI Robot Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:background="@color/ai_robot_background"
            android:gravity="center"
            android:layout_marginBottom="16dp"
            android:alpha="0.9">
            
            <ImageView
                android:layout_width="100dp"
                android:layout_height="120dp"
                android:src="@drawable/ai_robot_animated" />
                
        </LinearLayout>

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Profile Header Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/ai_robot_dark_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Profile Picture and Basic Info -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:id="@+id/profileImageView"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_premium_users"
                        android:background="@drawable/profile_circle_background"
                        android:scaleType="centerInside"
                        android:padding="16dp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp"
                        android:layout_gravity="center_vertical">

                        <TextView
                            android:id="@+id/profileNameText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="John Doe"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/glass_text_primary" />

                        <TextView
                            android:id="@+id/profileEmailText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="john.doe@example.com"
                            android:textSize="14sp"
                            android:textColor="@color/glass_text_secondary"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/memberSinceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Member since Jan 2024"
                            android:textSize="12sp"
                            android:textColor="@color/glass_text_secondary"
                            android:layout_marginTop="4dp" />

                        <TextView
                            android:id="@+id/lastActivityText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Last active: Today"
                            android:textSize="12sp"
                            android:textColor="@color/glass_text_secondary"
                            android:layout_marginTop="4dp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Edit Profile Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/editProfileButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Edit Profile"
                    android:textColor="@color/glass_text_primary"
                    android:backgroundTint="@color/glass_accent"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_premium_users"
                    app:iconTint="@color/glass_text_primary" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Subscription Card -->
        <androidx.cardview.widget.CardView
            android:id="@+id/subscriptionCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/ai_robot_dark_blue">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_premium_crown"
                        app:tint="@color/glass_accent"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Subscription"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_text_primary"
                        android:layout_marginStart="12dp" />

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="@color/glass_text_secondary" />

                </LinearLayout>

                <TextView
                    android:id="@+id/planNameText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pro Plan"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_accent"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/planDescriptionText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Enhanced AI experience with advanced features"
                    android:textSize="14sp"
                    android:textColor="@color/glass_text_secondary"
                    android:layout_marginBottom="8dp" />

                <!-- Subscription Tier Highlight -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:padding="12dp"
                    android:background="@drawable/rounded_corners"
                    android:backgroundTint="@color/glass_accent"
                    android:alpha="0.2">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current Tier"
                        android:textSize="12sp"
                        android:textColor="@color/glass_text_secondary" />

                    <TextView
                        android:id="@+id/subscriptionTierText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PRO"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_accent" />
                </LinearLayout>

                <TextView
                    android:id="@+id/subscriptionStatusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Active (25 days left)"
                    android:textSize="14sp"
                    android:textColor="@color/glass_accent"
                    android:layout_marginBottom="12dp" />

                <!-- Daily Usage Tracking -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Daily Tokens -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_time"
                            app:tint="@color/glass_accent"
                            android:layout_gravity="center_vertical"
                            android:layout_marginEnd="8dp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Daily Tokens Remaining"
                            android:textSize="12sp"
                            android:textColor="@color/glass_text_secondary" />

                        <TextView
                            android:id="@+id/dailyTokensProgressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="7,500 / 10,000"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:textColor="@color/glass_accent" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/dailyTokensProgressBar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"
                        android:progress="75"
                        android:progressTint="@color/glass_accent"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/tokenResetTimeText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Resets in 6 hours"
                        android:textSize="10sp"
                        android:textColor="@color/glass_text_secondary"
                        android:layout_marginBottom="12dp" />

                    <!-- Monthly Progress -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Monthly Usage"
                            android:textSize="12sp"
                            android:textColor="@color/glass_text_secondary" />

                        <TextView
                            android:id="@+id/monthlyProgressText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="45K / 300K"
                            android:textSize="12sp"
                            android:textColor="@color/glass_text_secondary" />

                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/monthlyProgressBar"
                        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="6dp"
                        android:progress="15"
                        android:progressTint="@color/glass_secondary"
                        android:layout_marginBottom="8dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/nextBillingText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Next billing: Feb 15, 2024"
                    android:textSize="12sp"
                    android:textColor="@color/glass_text_secondary" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Statistics Grid -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Total Chats with Recent History -->
            <androidx.cardview.widget.CardView
                android:id="@+id/chatHistoryCard"
                android:layout_width="0dp"
                android:layout_height="300dp"
                android:layout_weight="2"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/ai_robot_dark_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp">

                        <ImageView
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/glass_accent" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:id="@+id/totalChatsText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="42"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="@color/glass_text_primary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Total Chats"
                                android:textSize="10sp"
                                android:textColor="@color/glass_text_secondary" />
                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:src="@drawable/ic_arrow_right"
                            app:tint="@color/glass_text_secondary" />
                    </LinearLayout>

                    <!-- Recent Chat History List -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recentChatHistoryRecyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:scrollbars="vertical"
                        android:clipToPadding="false"
                        android:paddingBottom="8dp" />

                    <!-- Empty State -->
                    <LinearLayout
                        android:id="@+id/emptyChatHistoryLayout"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:visibility="gone">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/glass_text_secondary"
                            android:alpha="0.5"
                            android:layout_marginBottom="8dp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No chat history yet"
                            android:textSize="12sp"
                            android:textColor="@color/glass_text_secondary"
                            android:gravity="center" />
                    </LinearLayout>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Total Messages -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/ai_robot_dark_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_baseline_article_24"
                        app:tint="@color/glass_secondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/totalMessagesText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1,234"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Messages"
                        android:textSize="10sp"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Total Tokens -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/ai_robot_dark_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_analytics"
                        app:tint="@color/glass_accent"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/totalTokensText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="25K"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tokens"
                        android:textSize="10sp"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Second Row Statistics -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <!-- Favorite Chats -->
            <androidx.cardview.widget.CardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/ai_robot_dark_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_star_filled"
                        app:tint="@color/glass_secondary"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/favoriteChatsText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Favorites"
                        android:textSize="10sp"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <!-- Storage Used -->
            <androidx.cardview.widget.CardView
                android:id="@+id/usageAnalyticsCard"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/ai_robot_dark_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_analytics"
                        app:tint="@color/glass_accent"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/storageUsedText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2.5 GB"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Storage"
                        android:textSize="10sp"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Settings"
                android:textColor="@color/glass_text_primary"
                android:backgroundTint="@color/glass_secondary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_premium_settings"
                app:iconTint="@color/glass_text_primary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearHistoryButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="Clear History"
                android:textColor="@color/white"
                android:backgroundTint="@color/glass_text_secondary"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_delete"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Logout"
                android:textColor="@color/white"
                android:backgroundTint="@color/glass_accent"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_arrow_back"
                app:iconTint="@color/white" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>