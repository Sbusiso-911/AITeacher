<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    android:layout_marginBottom="8dp">

    <!-- Main message row with avatar positioned optimally -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start|top"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="48dp"> <!-- Right margin for more space -->

        <!-- AI Avatar - positioned at top left, smaller and non-intrusive -->
        <ImageView
            android:id="@+id/emojiImageView"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/ai_robot_icon"
            android:background="@drawable/circle_white_background"
            android:contentDescription="@string/ai_emoji" />

        <!-- Message bubble with copy icon overlay -->
        <RelativeLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <!-- Message content container -->
            <LinearLayout
                android:id="@+id/messageContentContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glassmorphism_message_received"
                android:padding="12dp"
                android:orientation="vertical">

                <!-- Action buttons row - dedicated first two lines -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="end"
                    android:layout_marginBottom="8dp">

                    <!-- Copy icon button -->
                    <ImageView
                        android:id="@+id/copy_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="8dp"
                        android:src="@drawable/ic_copy"
                        android:contentDescription="@string/copy_received_message"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/circle_white_background"
                        android:padding="4dp"
                        app:tint="@color/glass_text_primary"/>

                    <!-- Share icon button -->
                    <ImageView
                        android:id="@+id/share_icon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_share"
                        android:contentDescription="Share message"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@drawable/circle_white_background"
                        android:padding="4dp"
                        app:tint="@color/glass_text_primary"/>
                </LinearLayout>

                <!-- Message text content -->
                <com.playstudio.aiteacher.TypeWriterTextView
                    android:id="@+id/messageTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp"
                    android:lineSpacingExtra="2dp"
                    android:fontFamily="@font/montserrat"
                    android:autoLink="web"
                    android:linksClickable="true"
                    android:textIsSelectable="true"
                    android:visibility="gone"/> <!-- Initially gone, shown if not rich content -->
                <!-- WebView will be added here by the adapter if containsRichContent is true -->
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>

    <!-- Follow-up questions section (container for header and buttons) -->
<LinearLayout
android:id="@+id/followUpSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone"
    android:layout_marginStart="32dp"
    android:layout_marginTop="4dp">

<Button
android:id="@+id/followUpHeaderButton"
    style="?android:attr/borderlessButtonStyle"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:text="Suggested Follow-ups ▼"
    android:textAllCaps="false"
    android:textColor="@color/glass_text_secondary"
    android:textSize="12sp"
    android:minHeight="0dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"/>

<LinearLayout
android:id="@+id/followUpButtonsContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:visibility="gone" />
    </LinearLayout>

    </LinearLayout>