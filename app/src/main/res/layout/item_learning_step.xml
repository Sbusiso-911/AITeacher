<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/glass_message_received">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Step Header (Always Visible) -->
        <LinearLayout
            android:id="@+id/stepHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:gravity="center_vertical"
            android:clickable="true"
            android:focusable="true"
            android:background="?attr/selectableItemBackgroundBorderless">

            <!-- Step Progress Circle -->
            <FrameLayout
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp">

                <View
                    android:id="@+id/stepProgressCircle"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/step_pending_background" />

                <TextView
                    android:id="@+id/stepNumber"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat"
                    android:text="1" />
            </FrameLayout>

            <!-- Step Title and Brief -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/stepTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat"
                    android:text="Step Title" />

                <TextView
                    android:id="@+id/stepExplanation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="14sp"
                    android:fontFamily="@font/montserrat"
                    android:layout_marginTop="2dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:text="Step explanation preview..." />
            </LinearLayout>

            <!-- Expand/Collapse Icon -->
            <ImageView
                android:id="@+id/expandIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="@color/glass_text_secondary" />
        </LinearLayout>

        <!-- Expandable Content -->
        <LinearLayout
            android:id="@+id/expandableContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingHorizontal="16dp"
            android:paddingBottom="16dp">

            <!-- Divider -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/glass_border"
                android:layout_marginBottom="12dp" />

            <!-- Full Explanation -->
            <TextView
                android:id="@+id/fullStepExplanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/glass_text_primary"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:fontFamily="@font/montserrat"
                android:layout_marginBottom="8dp" />

            <!-- Step Output (if available) -->
            <LinearLayout
                android:id="@+id/stepOutputSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Result:"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/stepOutput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_output_field"
                    android:padding="12dp"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="14sp"
                    android:fontFamily="monospace"
                    android:text="Step output here" />
            </LinearLayout>

            <!-- Visual Aid Section (if available) -->
            <LinearLayout
                android:id="@+id/visualAidSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📊 Visual Aid:"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/visualAidDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_visual_aid_field"
                    android:padding="12dp"
                    android:textColor="@color/glass_text_secondary"
                    android:textSize="13sp"
                    android:fontFamily="@font/montserrat"
                    android:text="Visual aid description" />
            </LinearLayout>

            <!-- Hints Section (if available) -->
            <LinearLayout
                android:id="@+id/hintsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="💡 Helpful Hints:"
                    android:textColor="@color/glass_text_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/montserrat"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:id="@+id/hintsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>