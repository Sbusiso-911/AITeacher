<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/quantum_background">

    <!-- Action Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/glassmorphism_actionbar_background"
        android:paddingHorizontal="16dp"
        android:elevation="4dp">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_arrow_back"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:contentDescription="Back"
            app:tint="@android:color/white" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="AI Themes"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:layout_marginStart="16dp"
            android:fontFamily="@font/montserrat" />

        <ImageView
            android:id="@+id/btnThemeInfo"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_info"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:contentDescription="Theme info"
            app:tint="@android:color/white" />

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Current Theme Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glassmorphism_input_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Current Theme"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/montserrat" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imageViewCurrentTheme"
                        android:layout_width="60dp"
                        android:layout_height="60dp"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/glassmorphism_circle_button"
                        android:padding="8dp"
                        android:contentDescription="Current theme" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/textViewCurrentThemeName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cyber Robot"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="@android:color/white"
                            android:fontFamily="@font/montserrat" />

                        <TextView
                            android:id="@+id/textViewCurrentThemeDescription"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Futuristic AI robot with neural networks"
                            android:textSize="12sp"
                            android:textColor="@color/quantum_accent"
                            android:layout_marginTop="4dp"
                            android:fontFamily="@font/montserrat" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/btnChangeTheme"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Change"
                        android:textColor="@android:color/white"
                        android:background="@drawable/glassmorphism_button_primary"
                        android:paddingHorizontal="16dp"
                        android:fontFamily="@font/montserrat" />

                </LinearLayout>

            </LinearLayout>

            <!-- Theme Categories -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glassmorphism_input_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Theme Categories"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/montserrat" />

                <!-- Category Pills -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/chipCyberpunk"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="🤖 Cyberpunk"
                        android:textSize="12sp"
                        android:textColor="@color/cyber_primary"
                        android:background="@drawable/glassmorphism_button_background"
                        android:paddingHorizontal="12dp"
                        android:gravity="center"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/montserrat" />

                    <TextView
                        android:id="@+id/chipNeural"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="🧠 Neural"
                        android:textSize="12sp"
                        android:textColor="@color/brain_primary"
                        android:background="@drawable/glassmorphism_button_background"
                        android:paddingHorizontal="12dp"
                        android:gravity="center"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/montserrat" />

                    <TextView
                        android:id="@+id/chipQuantum"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="⚛️ Quantum"
                        android:textSize="12sp"
                        android:textColor="@color/quantum_primary"
                        android:background="@drawable/glassmorphism_button_background"
                        android:paddingHorizontal="12dp"
                        android:gravity="center"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/montserrat" />

                    <TextView
                        android:id="@+id/chipOrganic"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:text="🌿 Organic"
                        android:textSize="12sp"
                        android:textColor="@color/forest_primary"
                        android:background="@drawable/glassmorphism_button_background"
                        android:paddingHorizontal="12dp"
                        android:gravity="center"
                        android:layout_margin="4dp"
                        android:fontFamily="@font/montserrat" />

                </LinearLayout>

            </LinearLayout>

            <!-- Performance Settings -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glassmorphism_input_background"
                android:padding="16dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Performance Settings"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/montserrat" />

                <!-- Animation Quality -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Animation Quality"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/montserrat" />

                    <Spinner
                        android:id="@+id/spinnerQuality"
                        android:layout_width="120dp"
                        android:layout_height="wrap_content"
                        android:entries="@array/animation_quality_options"
                        android:background="@drawable/glassmorphism_button_background" />

                </LinearLayout>

                <!-- Battery Optimization -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Battery Optimization"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:fontFamily="@font/montserrat" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/switchBatteryOptimization"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="@color/forest_primary"
                        app:trackTint="@color/forest_primary_30" />

                </LinearLayout>

            </LinearLayout>

            <!-- Preview Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/glassmorphism_input_background"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Live Preview"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="12dp"
                    android:fontFamily="@font/montserrat" />

                <ImageView
                    android:id="@+id/imageViewLivePreview"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@drawable/glassmorphism_message_received"
                    android:scaleType="centerCrop"
                    android:contentDescription="Live theme preview" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>