<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/glassmorphism_chat_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Progress Bar -->
        <ProgressBar
            android:id="@+id/progressBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <!-- Current Subscription Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/glass_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/ic_premium_crown"
                        app:tint="@color/glass_accent"
                        android:layout_gravity="center_vertical" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Current Plan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_text_primary"
                        android:layout_marginStart="12dp" />

                </LinearLayout>

                <TextView
                    android:id="@+id/currentPlanText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Free Plan"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_accent"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Status:"
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                    <TextView
                        android:id="@+id/subscriptionStatusText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Free"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Time Remaining:"
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                    <TextView
                        android:id="@+id/daysRemainingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No expiration"
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Price:"
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                    <TextView
                        android:id="@+id/priceText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Free"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/glass_accent" />

                </LinearLayout>

                <!-- Features -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Features:"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_text_primary"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/featuresText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="• Basic AI models\n• 50 messages/month\n• Community support"
                    android:textSize="14sp"
                    android:textColor="@color/glass_text_secondary"
                    android:layout_marginBottom="16dp" />

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Billing Information Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:cardBackgroundColor="@color/glass_background">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Billing Information"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/glass_text_primary"
                    android:layout_marginBottom="16dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Billing Cycle:"
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                    <TextView
                        android:id="@+id/billingCycleText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Next Billing:"
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                    <TextView
                        android:id="@+id/nextBillingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="No billing"
                        android:textSize="14sp"
                        android:textColor="@color/glass_text_secondary" />

                </LinearLayout>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/upgradeButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Upgrade to Premium"
                android:textColor="@color/white"
                android:backgroundTint="@color/glass_accent"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_premium_upgrade"
                app:iconTint="@color/white" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/renewButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:text="Renew Subscription"
                android:textColor="@color/white"
                android:backgroundTint="@color/glass_accent"
                app:cornerRadius="12dp"
                app:icon="@drawable/ic_premium_star"
                app:iconTint="@color/white"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/managePaymentButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:text="Payment"
                    android:textColor="@color/glass_text_primary"
                    android:backgroundTint="@color/glass_secondary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_premium_settings"
                    app:iconTint="@color/glass_text_primary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancelButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="8dp"
                    android:text="Cancel"
                    android:textColor="@color/white"
                    android:backgroundTint="@color/glass_text_secondary"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_cancel"
                    app:iconTint="@color/white"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>