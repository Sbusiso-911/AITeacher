<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/code_syntax_background"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/codeTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/glass_text_primary"
            android:fontFamily="@font/montserrat" />

        <TextView
            android:id="@+id/codeLanguage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            android:textColor="@color/glass_text_secondary"
            android:fontFamily="@font/montserrat"
            android:background="@drawable/chip_subject_background"
            android:padding="4dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/codeContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/code_keyword"
        android:fontFamily="monospace"
        android:background="@drawable/bg_output_field"
        android:padding="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/codeExplanation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textColor="@color/glass_text_secondary"
        android:fontFamily="@font/montserrat" />

</LinearLayout>