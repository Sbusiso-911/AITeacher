rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All user-scoped data lives under /users/{userId}
    match /users/{userId} {
      // Allow the signed-in user to read and write their root profile document
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Chat sessions collection
      match /chat_sessions/{sessionId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        // Messages within a chat session
        match /messages/{messageId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // Optional subscription documents nested under the user
      match /subscriptions/{subId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Root-level subscription docs for administrative access
    match /subscriptions/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Legacy top-level chats collection access (if still present)
    match /chats/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
